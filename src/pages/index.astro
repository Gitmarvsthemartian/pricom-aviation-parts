
---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const company = "PRICOM Aviation Parts";
const phone = "17739616429";
const email = "info@pricomaviationparts.com";

const categories = [
  {
    number: "01",
    title: "Aircraft Parts",
    description: "Quality aircraft components and replacement parts for your aviation needs.",
  },
  {
    number: "02",
    title: "Aviation Supplies",
    description: "Essential aviation supplies and materials to keep your operations moving.",
  },
  {
    number: "03",
    title: "Parts Sourcing",
    description: "Reliable sourcing solutions for hard-to-find aviation components.",
  },
];

const benefits = [
  "Quality-focused sourcing",
  "Responsive customer support",
  "Reliable parts solutions",
  "Professional service",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="PRICOM Aviation Parts provides aviation parts, supplies, and sourcing solutions. Contact our team for your aircraft component requirements." />
    <meta name="theme-color" content="#06265b" />
    <title>PRICOM Aviation Parts | Reliable Aviation Solutions</title>
  </head>

  <body>
    <Header />

    <main>
      <section class="hero" id="home">
        <div class="hero-pattern"></div>
        <div class="container hero-content">
          <div class="hero-text">
            <span class="eyebrow"><span class="dot"></span> YOUR AVIATION PARTNER</span>
            <h1>Reliable Parts.<br /><span class="home-heading">Elevated Aviation.</span></h1>
            <p>
              Connecting you with dependable aviation parts and sourcing
              solutions to keep your operations moving forward.
            </p>

            <div class="hero-actions">
              <a href="#services" class="btn btn-primary">Explore Our Services <span>→</span></a>
              <a href="#contact" class="btn btn-outline">Contact Our Team</a>
            </div>

            <div class="hero-trust">
              <span class="trust-line"></span>
              <span>Committed to quality. Focused on reliability.</span>
            </div>
          </div>

          <div class="hero-visual">
            <div class="visual-card">
              <div class="visual-top">
                <span>AVIATION</span>
                <span class="visual-status"><span></span> PARTS & SOLUTIONS</span>
              </div>
              <div class="aviation-symbol">
                <svg viewBox="0 0 420 260" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Decorative aircraft illustration">
                  <path d="M205 24 L215 24 L230 115 L370 164 L370 178 L230 157 L230 215 L270 240 L270 250 L210 236 L150 250 L150 240 L190 215 L190 157 L50 178 L50 164 L190 115 Z" fill="#0A3477" />
                  <path d="M210 24 L215 24 L230 115 L370 164 L370 178 L230 157 L230 215 L270 240 L270 250 L210 236 L150 250 L150 240 L190 215 L190 157 L50 178 L50 164 L190 115 Z" stroke="#9BB8D8" stroke-width="2" />
                  <path d="M210 40 L210 225" stroke="#5B8E54" stroke-width="2" stroke-dasharray="5 7"/>
                  <circle cx="210" cy="128" r="35" fill="#F4F7FB" stroke="#5B8E54" stroke-width="3"/>
                  <path d="M210 100 L224 128 L210 157 L196 128 Z" fill="#0A3477"/>
                </svg>
              </div>
              <div class="visual-bottom">
                <div>
                  <strong>PRICOM</strong>
                  <span>AVIATION PARTS</span>
                </div>
                <span class="visual-arrow">↗</span>
              </div>
            </div>
            <div class="floating-badge">
              <span class="badge-icon">✦</span>
              <div>
                <strong>Built on Reliability</strong>
                <span>Driven by Quality</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hero-bottom-line">
          <span>AVIATION PARTS & PROCUREMENT</span>
          <span>PRECISION · QUALITY · RELIABILITY</span>
        </div>
      </section>

      <section class="services section" id="services">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="eyebrow">WHAT WE DO</span>
              <h2>Aviation solutions<br />you can <span class="home-heading">count on.</span></h2>
            </div>
            <p>
              Supporting your aviation requirements with dependable parts,
              sourcing expertise, and professional service.
            </p>
          </div>

          <div class="service-grid">
            {categories.map((item) => (
              <article class="service-card">
                <span class="card-number">{item.number}</span>
                <div class="service-icon">
                  {item.number === "01" && <span>✈</span>}
                  {item.number === "02" && <span>⚙</span>}
                  {item.number === "03" && <span>↗</span>}
                </div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <a href="#contact" class="card-link">Discuss your requirements <span>→</span></a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="about section" id="about">
        <div class="container about-grid">
          <div class="about-visual">
            <div class="about-accent"></div>
            <img src="/logo.png" alt="PRICOM Aviation Parts emblem" />
            <div class="about-label">
              <span class="label-line"></span>
              <span>YOUR TRUSTED AVIATION PARTNER</span>
            </div>
          </div>

          <div class="about-content">
            <span class="eyebrow">ABOUT PRICOM</span>
            <h2>Committed to keeping aviation <span class="home-heading">moving.</span></h2>
            <p>
              PRICOM Aviation Parts is dedicated to supporting aviation
              professionals with quality-focused parts and dependable sourcing
              solutions.
            </p>
            <p>
              We believe that reliability, responsive communication, and
              attention to detail are essential in every aviation partnership.
            </p>

            <div class="benefits">
              {benefits.map((benefit) => (
                <div class="benefit">
                  <span class="check">✓</span>
                  <span>{benefit}</span>
                </div>
              ))}
            </div>

            <a href="#contact" class="btn btn-primary">Let's Work Together <span>→</span></a>
          </div>
        </div>
      </section>

      
    </main>
<Footer />
    
  </body>
</html>


